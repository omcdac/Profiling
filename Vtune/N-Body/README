#!/bin/bash

pip3 install numpy matplotlib

cd N-Body

make clean

make 

export OMP_NUM_THREADS=4

time ./nbody

vtune -collect hotspots -knob sampling-mode=hw -result-dir vtune-nbody ./nbody

vtune -collect hotspots -knob sampling-mode=hw -result-dir vtune-nbody-opt ./nbody

python simulation.py

